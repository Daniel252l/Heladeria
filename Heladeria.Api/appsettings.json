{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Heladeria": ""
  },
  "Cors": {
    "OrigenesPermitidos": []
  },
  "Seguridad": {
    "Jwt": {
      "Emisor": "Heladeria.Api",
      "Audiencia": "Heladeria.Web",
      "ClaveFirma": "",
      "MinutosAccessToken": 10,
      "DiasRefreshToken": 7
    },
    "Contrasenas": {
      "LongitudMinima": 10,
      "RequiereMayuscula": true,
      "RequiereMinuscula": true,
      "RequiereNumero": true,
      "RequiereCaracterEspecial": true,
      "AplicarVencimientoPorRolEnMeses": true
    },
    "Bloqueo": {
      "IntentosMaximos": 5,
      "MinutosBloqueo": 15
    },
    "CookieRefresh": {
      "Nombre": "heladeria.refresh",
      "SameSite": "Strict"
    },
    "RateLimiting": {
      "IntentosLogin": 10,
      "Renovaciones": 20,
      "CambiosContrasena": 5,
      "VentanaSegundos": 60
    },
    "EstadosActivos": [
      "Activo"
    ],
    "ZonaHoraria": "America/Guatemala"
  },
  "AllowedHosts": "localhost"
}
